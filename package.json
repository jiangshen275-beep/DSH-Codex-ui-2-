{
  "name": "dsh-codex-ui",
  "version": "3.0.0",
  "description": "Codex-style interface and prompt modes for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "locale",
    "prompts",
    "scripts",
    "computer-use",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "MIGRATION-2.0.zh.md",
    "SIDEBAR-RAIL.zh.md",
    "SIDEBAR-RAIL-USER.zh.md",
    "THIRD-PARTY-NOTICES.md",
    "RESOURCE-REFERENCE.zh.md",
    "SYSTEM-PROMPT-PLAN.zh.md"
  ],
  "scripts": {
    "build": "node scripts/build-reply-forge.mjs && node scripts/build.mjs",
    "check": "node scripts/build-reply-forge.mjs --check && node --check src/client.js && node --check src/model-ui.js && node --check src/prompt-modes.js && node --check src/turbo.js && node --check src/turbo-policy.js && node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.mjs && node --test \"src/reply-forge/tests/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-session-log-export"
      ]
    }
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "license": "MIT",
  "author": "jiangshen275-beep",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "codex",
    "ui-plugin",
    "reasoning-effort",
    "subagents"
  ],
  "engines": {
    "node": ">=20"
  },
  "icon": "./assets/codex.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangshen275-beep/DSH-Codex-ui-2-.git"
  },
  "homepage": "https://github.com/jiangshen275-beep/DSH-Codex-ui-2-",
  "bugs": {
    "url": "https://github.com/jiangshen275-beep/DSH-Codex-ui-2-/issues"
  }
}
